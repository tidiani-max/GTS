# Copy to backend/.env for local (non-Docker) development. NEVER commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://gst:gst@localhost:5432/gst
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (>= 32 chars required in production)
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:8443,http://localhost:8080
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CONTACT=5/600
RATE_LIMIT_LOGIN=10/300
# console = log only (default) | smtp | disabled
EMAIL_MODE=console
EMAIL_FROM=GST <no-reply@gst-demo.ml>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Seed (demo only): first super-admin created by `python -m app.seed`
SEED_ADMIN_EMAIL=admin@gst-demo.ml
SEED_ADMIN_PASSWORD=ChangeMe!2025
